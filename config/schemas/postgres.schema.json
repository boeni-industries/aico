{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PostgreSQL Configuration",
  "description": "Primary PostgreSQL database connection and schema settings",
  "type": "object",
  "required": ["host", "port", "db_name", "user"],
  "properties": {
    "host": {
      "type": "string",
      "description": "PostgreSQL server hostname"
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535,
      "description": "PostgreSQL server port"
    },
    "db_name": {
      "type": "string",
      "description": "Database name"
    },
    "user": {
      "type": "string",
      "description": "Database user"
    },
    "password": {
      "type": "string",
      "description": "Database password (managed via AICOKeyManager)"
    },
    "schema": {
      "type": "string",
      "description": "Default schema name"
    },
    "pool_size": {
      "type": "integer",
      "minimum": 1,
      "description": "Connection pool size"
    },
    "max_overflow": {
      "type": "integer",
      "minimum": 0,
      "description": "Maximum overflow connections"
    },
    "pool_timeout": {
      "type": "number",
      "minimum": 0,
      "description": "Connection pool timeout in seconds"
    },
    "pool_recycle": {
      "type": "integer",
      "minimum": -1,
      "description": "Recycle connections after N seconds (-1 = never, 0 = always, >0 = after N seconds)"
    },
    "pool_pre_ping": {
      "type": "boolean",
      "description": "Verify connections are alive before using them (health check)"
    }
  }
}
