{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI Configuration",
  "description": "AI subsystem settings (intent classification and other AI processors)",
  "type": "object",
  "properties": {
    "intent_classifier": {
      "type": "object",
      "properties": {
        "confidence_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "cache_size": {
          "type": "integer",
          "minimum": 0
        },
        "context_window": {
          "type": "integer",
          "minimum": 0
        },
        "enable_few_shot": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
