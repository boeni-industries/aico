FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TOKENIZERS_PARALLELISM=false

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    build-essential \
    g++ \
  && rm -rf /var/lib/apt/lists/*

RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"

COPY pyproject.toml uv.lock README.md VERSIONS /app/

# Install deps (without installing the local project) so this layer is stable
# across source-only changes.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --extra modelservice --no-install-project

COPY shared /app/shared
COPY backend /app/backend
COPY cli /app/cli
COPY modelservice /app/modelservice
COPY proto /app/proto
COPY config /app/config

# Install the local project into the already-synced environment.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install -e .

CMD ["uv", "run", "python", "-m", "modelservice.main"]
